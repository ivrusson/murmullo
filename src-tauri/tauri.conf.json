{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Murmullo",
  "version": "0.7.0",
  "identifier": "com.murmullo.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Murmullo",
        "url": "index.html",
        "width": 1000,
        "height": 700,
        "decorations": true,
        "resizable": true,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "create": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      },
      {
        "label": "floating-bar",
        "title": "Murmullo Voice Dictation Bar",
        "url": "floating-bar.html",
        "width": 560,
        "height": 168,
        "decorations": false,
        "resizable": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "visible": true,
        "focus": false,
        "skipTaskbar": true,
        "hiddenTitle": true,
        "visibleOnAllWorkspaces": true,
        "maximizable": false,
        "minimizable": false,
        "acceptFirstMouse": true
      },
      {
        "label": "crash-reporter",
        "title": "Murmullo",
        "url": "crash://localhost/",
        "width": 520,
        "height": 640,
        "minWidth": 420,
        "minHeight": 480,
        "decorations": true,
        "resizable": true,
        "center": true,
        "visible": false,
        "create": false
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
