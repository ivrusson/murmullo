{
  "name": "murmullo",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "description": "Offline voice dictation for macOS — local STT with nemo-speech and Parakeet",
  "author": "Iván Subsierra",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ivrusson/murmullo.git"
  },
  "keywords": [
    "voice",
    "dictation",
    "speech-to-text",
    "parakeet",
    "tauri",
    "offline",
    "desktop"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "icons": "./generate-icons.sh",
    "icons:custom": "./generate-icons.sh",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint src --ext .ts,.tsx --report-unused-disable-directives --max-warnings 0",
    "type-check": "tsc --noEmit",
    "release": "release-it",
    "release:patch": "release-it patch",
    "release:minor": "release-it minor",
    "release:major": "release-it major",
    "release:dry": "release-it --dry-run",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "commit": "cz",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@stylexjs/stylex": "^0.19.1",
    "@tanstack/react-router": "^1.170.38",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "ahooks": "^3.8.1",
    "lucide-react": "^0.546.0",
    "next-themes": "^0.4.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tauri-plugin-macos-permissions-api": "^2.3.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@release-it/bumper": "^7.0.5",
    "@stylexjs/eslint-plugin": "^0.19.1",
    "@stylexjs/unplugin": "^0.19.1",
    "@tanstack/router-plugin": "^1.168.40",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.9.1",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@types/three": "^0.186.0",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "@vitejs/plugin-react": "^4.2.1",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.38.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "prettier": "^3.6.2",
    "release-it": "^17.10.0",
    "sharp": "^0.34.4",
    "typescript": "^5.2.2",
    "unplugin": "2.3.11",
    "vite": "^5.3.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,json,css,md}": [
      "prettier --write"
    ],
    "src-tauri/**/*.rs": "sh -c 'cargo fmt --manifest-path src-tauri/Cargo.toml --all'"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
