{
  "name": "murmullo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Offline Voice Dictation App - Real-time speech-to-text with Whisper",
  "author": "Iván Subsierra",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ivrusson/murmullo.git"
  },
  "keywords": [
    "voice",
    "dictation",
    "speech-to-text",
    "whisper",
    "tauri",
    "offline",
    "desktop"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "icons": "./generate-icons.sh",
    "icons:custom": "./generate-icons.sh",
    "icons:example": "./create-example-icon.sh && ./generate-icons.sh",
    "rebuild": "./rebuild-with-icons.sh",
    "lint": "eslint src --ext .ts,.tsx --report-unused-disable-directives --max-warnings 0",
    "type-check": "tsc --noEmit",
    "release": "release-it",
    "release:patch": "release-it patch",
    "release:minor": "release-it minor",
    "release:major": "release-it major",
    "release:dry": "release-it --dry-run",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "commit": "cz",
    "prepare": "husky"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@tauri-apps/api": "^2",
    "ahooks": "^3.8.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "lucide-react": "^0.546.0",
    "next-themes": "^0.4.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tauri-plugin-macos-permissions-api": "^2.3.0"
  },
  "devDependencies": {
    "@release-it/bumper": "^7.0.5",
    "@tailwindcss/postcss": "^4.0.0",
    "@tailwindcss/vite": "^4.1.15",
    "@tauri-apps/cli": "^2",
    "@types/node": "^24.9.1",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.21",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.38.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "release-it": "^17.10.0",
    "sharp": "^0.34.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.2.2",
    "vite": "^5.3.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,json,css,md}": [
      "prettier --write"
    ],
    "src-tauri/**/*.rs": [
      "cargo fmt",
      "cargo clippy --fix --allow-dirty --allow-staged"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
